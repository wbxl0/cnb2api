+def strip_residual_markup(
+    text: Any,
+    config: Optional[Union[ToolCallConfig, Mapping[str, Any]]] = None,
+    *,
+    harden: bool = True,
+) -> str:
+    """Remove leftover XYML/QNML tool-call envelopes from text before it reaches the client.
+
+    The parser intentionally drops calls that do not survive coercion (missing
+    required args, invalid values, unknown tools). In those cases the raw
+    protocol markup must not leak into the user-visible content stream.
+
+    When ``harden`` is True (default) out-of-fence line breaks are also
+    promoted to blank lines. Streaming callers should pass ``harden=False``
+    and apply :func:`harden_line_breaks_stateful` themselves so code-fence
+    state survives across chunks.
+    """
+    if not text:
+        return ""
+    raw = str(text)
+    cfg = _resolve_config(config)
+    for protocol in cfg.parse_protocols:
+        root = protocol.tags["root"]
+        # Drop full tool_calls envelopes (root block) entirely.
+        raw = _protocol_tag_block_re(
+            protocol, root, allow_short_close=True
+        ).sub("", raw)
+        # Drop standalone invoke/parameter blocks that survived without a root.
+        for tag in (protocol.tags["invoke"], protocol.tags["parameter"]):
+            raw = _protocol_tag_block_re(
+                protocol, tag, allow_short_close=True
+            ).sub("", raw)
+        # Drop loose open/close tags that no longer belong to a block.
+        raw = _protocol_open_tag_re(protocol, root).sub("", raw)
+        raw = _protocol_open_tag_re(protocol, protocol.tags["invoke"]).sub("", raw)
+        raw = _protocol_open_tag_re(protocol, protocol.tags["parameter"]).sub("", raw)
+        raw = _protocol_tag_block_re(
+            protocol, root, allow_short_close=True
+        ).sub("", raw)
+    # Last-resort: remove any residual protocol closing tags (</|XYML|invoke>,
+    # </|XYML> etc.) that block-matching may have left behind.
+    raw = re.sub(
+        r"<\s*/\s*\|\s*[A-Za-z0-9_-]+\s*(?:\|\s*[A-Za-z0-9_-]+\s*)?>",
+        "",
+        raw,
+        flags=re.IGNORECASE,
+    )
+    if harden:
+        raw = harden_line_breaks(raw)
+    return raw.strip()
+
+
+def harden_line_breaks(text: str) -> str:
+    """Promote every out-of-fence line break to a blank line.
+
+    opencode (and similar terminal markdown viewers) trims trailing spaces and
+    then collapses a lone newline into a space, so a model's hard break
+    ("  \\n") or a plain single newline outside a fenced code block renders as
+    "squashed together" rows — worst with emoji/symbol-heavy lines. A blank
+    line (\\n\\n) is never collapsed, so promote out-of-fence breaks to blank
+    lines. Inside fenced code blocks line breaks are preserved exactly.
+    """
+    if not text:
+        return text
+    out, _ = harden_line_breaks_stateful(text, in_fence=False)
+    return out
+
+
+def harden_line_breaks_stateful(
+    text: str, in_fence: bool = False
+) -> Tuple[str, bool]:
+    """Fence-aware version of :func:`harden_line_breaks` for streaming use.
+
+    Returns ``(text, in_fence)`` so callers can carry the code-fence state
+    across chunks (a ``` split across two SSE chunks must not corrupt either
+    half). Outside a fence every non-blank line is followed by a blank line so
+    a lone ``\\n`` renders as a paragraph break; inside a fence rows are kept
+    byte-for-byte.
+    """
+    if not text:
+        return text, in_fence
+    raw = str(text)
+    lines = raw.split("\n")
+    out: List[str] = []
+    fence = in_fence
+    for line in lines:
+        if line.lstrip().startswith("```"):
+            fence = not fence
+            out.append(line)
+            continue
+        if not fence and line.strip():
+            # Drop trailing whitespace (the renderer would trim it anyway) and
+            # add a blank line so a lone \n renders as a real row break.
+            out.append(line.rstrip())
+            out.append("")
+        else:
+            out.append(line)
+    # Drop trailing blank lines, then collapse any run of blank lines.
+    while out and out[-1] == "":
+        out.pop()
+    result: List[str] = []
+    prev_blank = False
+    for line in out:
+        if line == "":
+            if prev_blank:
+                continue
+            prev_blank = True
+        else:
+            prev_blank = False
+        result.append(line)
+    return "\n".join(result), fence
+
+
